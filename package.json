{
  "name": "sstory-worldbuilding",
  "version": "1.0.0",
  "description": "SStory - Eternal Arcadia Worldbuilding Project",
  "private": true,
  "scripts": {
    "lint": "markdownlint \"**/*.md\" --ignore node_modules --ignore evaluation --ignore Language/Evaluation",
    "links": "node scripts/run-markdown-link-check.js",
    "spell": "cspell \"**/*.md\" --no-progress",
    "frontmatter": "node scripts/validate-frontmatter.js",
    "consistency": "node scripts/validate-consistency.js",
    "terminology": "node scripts/run-python.js tools/terminology_check.py",
    "map:sync": "node scripts/run-python.js world/map-data/scripts/sync_map_data.py",
    "map:validate": "node scripts/run-python.js tools/map/validate_map_data.py && node scripts/run-python.js world/map-data/scripts/validate_pois.py && node scripts/run-python.js world/map-data/scripts/sync_map_data.py --check",
    "validate": "npm run lint && npm run links && npm run spell && npm run frontmatter && npm run consistency && npm run terminology && npm run map:validate",
    "test:node": "node --test test/*.test.js",
    "test:python": "node scripts/run-python.js -m unittest discover -s tests -p \"*_test.py\"",
    "test:unit": "npm run test:node && npm run test:python",
    "test": "npm run validate && npm run test:unit"
  },
  "keywords": [
    "worldbuilding",
    "fantasy",
    "trpg",
    "setting",
    "markdown"
  ],
  "author": "halc8312",
  "license": "CC-BY-SA-4.0",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "run-con": {
      "ini": "6.0.0"
    }
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "markdownlint-cli": "^0.49.1",
    "markdown-link-check": "^3.10.0",
    "cspell": "^8.0.0",
    "yaml": "^2.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/halc8312/SStory.git"
  }
}
