* text=auto eol=lf

# Keep source and content files deterministic across Windows and Linux.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# This hash-locked ImageGen prompt intentionally preserves its original
# terminal blank line as part of the generation provenance.
world/map-production/prompts/highland-detail-exemplar-v1.generation.txt whitespace=-blank-at-eof

# Binary assets must never undergo newline conversion.
*.jpg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary
