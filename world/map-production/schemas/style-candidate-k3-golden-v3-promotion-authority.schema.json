        "generation_seals": { "type": "null" },
        "strict_audit_report": { "type": "null" },
        "root_review": { "type": "null" },
        "blind_packet": { "type": "null" },
        "blind_reviews": { "type": "null" },
        "acceptance_receipt": { "type": "null" }
      },
      "additionalProperties": false
    },
    "promotion_implementation": {
