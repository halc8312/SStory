  "properties": {
    "$schema": {
      "const": "https://sstory.example/schemas/style-candidate-k3-golden-v3-promotion-authority.schema.json"
    },
    "schema_version": { "const": "3.0.0" },
    "id": { "const": "sstory-k3-golden-v3-candidate-blind-promotion-authority-v3" },
    "status": { "const": "frozen-before-active-contract-candidate-evaluation" },
    "freeze_scope": {
