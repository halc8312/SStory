{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sstory.example/schemas/style-candidate-k3-golden-v3-promotion-authority.schema.json",
  "title": "SStory Golden v3 candidate-blind promotion authority",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "id",
    "status",
    "freeze_scope",
    "promotion_performed",
    "runtime_bindings",
    "promotion_implementation",
    "authorities",
    "bound_schemas",
    "identity",
    "output_contract",
    "generation_contract",
    "strict_audit_contract",
    "review_contract",
    "manifest_contract",
    "receipt_contract",
