        "four_candidate_derivation": { "$ref": "#/definitions/artifact" },
        "four_candidate_generator": { "$ref": "#/definitions/artifact" },
        "balanced_phase_v2": { "$ref": "#/definitions/artifact" },
        "balanced_phase_v2_generator": { "$ref": "#/definitions/artifact" },
        "balanced_open_phase_v3": { "$ref": "#/definitions/artifact" },
        "balanced_open_phase_v3_generator": { "$ref": "#/definitions/artifact" }
