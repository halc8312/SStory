        "candidate_images_read_before_freeze": 0,
        "audit_results_read_before_freeze": 0,
        "threshold_selection_from_candidate_values": false,
        "legacy_contract_status": {
          "four-candidate-v1": "evaluated-and-rejected-before-this-revision; compatibility-only",
          "balanced-phase-v2": "evaluated-and-rejected-before-this-revision; compatibility-only"
        }
      }
