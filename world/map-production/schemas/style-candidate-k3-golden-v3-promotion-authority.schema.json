        "authority": { "$ref": "#/definitions/artifact" },
        "acceptance_receipt": { "$ref": "#/definitions/artifact" },
        "qa_report": { "$ref": "#/definitions/artifact" },
        "production_manifest": { "$ref": "#/definitions/artifact" }
