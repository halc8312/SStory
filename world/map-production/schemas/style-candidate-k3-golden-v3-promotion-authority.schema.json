    "promotion_performed": { "const": false },
    "runtime_bindings": {
      "type": "object",
      "required": [
        "candidate",
        "generation_seals",
        "strict_audit_report",
        "root_review",
        "blind_packet",
        "blind_reviews",
        "acceptance_receipt"
