              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "hillshade_tanh_gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
            "hillshade_balance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "hillshade_asymmetry": {"type": "number", "minimum": 0, "maximum": 0.5},
            "hillshade_asymmetry_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "intermediate_field_scale": {"type": "number", "minimum": 16, "maximum": 120},
            "hillshade_smoothing_radius_px": {"type": "number", "minimum": 0.5, "maximum": 16},
            "field_tail_transform": {"const": "signed-tail-attenuation-then-tanh-extrema-cap"},
            "field_tail_activation_scale": {"type": "number", "minimum": 0.01, "maximum": 1},
            "field_extrema_scale": {"type": "number", "minimum": 0.1, "maximum": 1},
            "source_low_pass_radius_px": {"type": "integer", "minimum": 1, "maximum": 256},
            "permission_envelope": {
              "type": "object",
              "required": ["shape", "zero_through_x", "opaque_from_x"],
              "properties": {
                "shape": {"const": "right-side-cosine-ramp"},
                "zero_through_x": {"type": "integer", "minimum": 0, "maximum": 1534},
                "opaque_from_x": {"type": "integer", "minimum": 1, "maximum": 1535}
              },
              "additionalProperties": false
            },
            "preserve_high_frequency_residual": {"const": true},
            "purpose": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "required": ["low_pass", "regional_gain"],
          "not": {
            "anyOf": [
              {"required": ["minimum_areal_support"]},
              {"required": ["topology_mesh"]},
              {"required": ["topology_zones"]},
              {"required": ["topology_ridges"]},
              {"required": ["topology_compact_ridges"]}
            ]
          }
        },
        {
          "required": ["minimum_areal_support"],
          "not": {
            "anyOf": [
              {"required": ["low_pass"]},
              {"required": ["regional_gain"]},
              {"required": ["topology_mesh"]},
              {"required": ["topology_zones"]},
              {"required": ["topology_ridges"]},
              {"required": ["topology_compact_ridges"]}
            ]
          }
        },
        {
          "required": ["topology_mesh"],
          "not": {
            "anyOf": [
              {"required": ["low_pass"]},
              {"required": ["regional_gain"]},
              {"required": ["minimum_areal_support"]},
              {"required": ["topology_zones"]},
              {"required": ["topology_ridges"]},
              {"required": ["topology_compact_ridges"]}
            ]
          }
        },
        {
          "required": ["topology_zones"],
          "not": {
            "anyOf": [
              {"required": ["low_pass"]},
              {"required": ["regional_gain"]},
              {"required": ["minimum_areal_support"]},
              {"required": ["topology_mesh"]},
              {"required": ["topology_ridges"]},
              {"required": ["topology_compact_ridges"]}
            ]
          }
        },
        {
          "required": ["topology_ridges"],
          "not": {
            "anyOf": [
              {"required": ["low_pass"]},
