{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sstory.example/schemas/luminance-plate-calibration-v2.schema.json",
  "title": "SStory deterministic luminance plate calibration control v2",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "report_id",
    "created_at",
    "coordinate_space",
    "canvas",
    "source_image",
    "transfer_control",
    "calibration",
    "numeric_contract",
    "safety",
    "expected_transfer_preflight",
    "purpose"
  ],
  "properties": {
    "schema_version": {"enum": ["1.1.0", "1.2.0"]},
    "schema_lock": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
    "report_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
    "created_at": {"type": "string", "format": "date-time"},
    "coordinate_space": {"const": "source-pixels-y-down"},
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "source_image": {
      "type": "object",
      "required": ["path", "sha256", "mode", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mode": {"const": "RGB"},
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "transfer_control": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "raster_path",
        "raster_sha256",
        "functional_reference_path",
        "functional_reference_sha256",
        "allowed_metadata_differences"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raster_path": {"type": "string", "minLength": 1},
        "raster_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "functional_reference_path": {"type": "string", "minLength": 1},
        "functional_reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "allowed_metadata_differences": {
          "type": "array",
          "prefixItems": [
            {"const": "id"},
            {"const": "transfer_report_id"},
            {"const": "purpose"},
            {"const": "notes"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "low_pass": {
          "type": "object",
          "required": ["method", "radius_px"],
          "properties": {
            "method": {"const": "gaussian"},
            "radius_px": {"type": "integer", "minimum": 1, "maximum": 256}
          },
          "additionalProperties": false
        },
        "regional_gain": {
          "type": "object",
          "required": [
            "region_id",
            "gain",
            "center_statistic",
            "sample_scope",
            "preserve_high_frequency_residual",
            "apply_transfer_region_feather"
          ],
          "properties": {
            "region_id": {"type": "string", "minLength": 1},
            "gain": {"type": "number", "exclusiveMinimum": 1, "maximum": 4},
            "center_statistic": {"const": "median"},
            "sample_scope": {"const": "opaque-core-excluding-road-guard"},
            "preserve_high_frequency_residual": {"const": true},
            "apply_transfer_region_feather": {"const": true}
          },
          "additionalProperties": false
        },
        "minimum_areal_support": {
          "type": "object",
          "required": [
            "region_id",
            "target_quadrant",
            "shape",
            "center",
            "radii",
            "amplitude_levels",
            "apply_transfer_region_feather",
            "purpose"
          ],
          "properties": {
            "region_id": {"type": "string", "minLength": 1},
            "target_quadrant": {"type": "integer", "minimum": 1, "maximum": 4},
            "shape": {"const": "cosine-squared-ellipse"},
            "center": {
              "type": "array",
              "prefixItems": [{"type": "integer"}, {"type": "integer"}],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "radii": {
              "type": "array",
              "prefixItems": [
                {"type": "integer", "minimum": 1},
                {"type": "integer", "minimum": 1}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "amplitude_levels": {"type": "integer", "minimum": -20, "maximum": 20, "not": {"const": 0}},
            "apply_transfer_region_feather": {"const": true},
            "purpose": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "topology_mesh": {
          "type": "object",
          "required": [
            "preflight_region_ids",
            "grid",
            "interpolation",
            "smoothing_radius_px",
            "source_low_pass_radius_px",
            "permission_envelope",
            "preserve_high_frequency_residual",
            "purpose"
          ],
          "properties": {
            "preflight_region_ids": {
              "type": "array",
              "prefixItems": [
                {"const": "north_east_range"},
                {"const": "south_east_range"}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "grid": {
              "type": "object",
              "required": ["width", "height", "values"],
              "properties": {
                "width": {"type": "integer", "minimum": 3, "maximum": 32},
                "height": {"type": "integer", "minimum": 3, "maximum": 32},
                "values": {
                  "type": "array",
                  "items": {"type": "integer", "minimum": 0, "maximum": 255},
                  "minItems": 9,
                  "maxItems": 1024
                }
              },
              "additionalProperties": false
            },
            "interpolation": {"const": "bicubic"},
            "smoothing_radius_px": {"type": "integer", "minimum": 1, "maximum": 256},
            "source_low_pass_radius_px": {"type": "integer", "minimum": 1, "maximum": 256},
            "permission_envelope": {
              "type": "object",
              "required": ["shape", "zero_through_x", "opaque_from_x"],
              "properties": {
                "shape": {"const": "right-side-cosine-ramp"},
                "zero_through_x": {"type": "integer", "minimum": 0, "maximum": 1534},
                "opaque_from_x": {"type": "integer", "minimum": 1, "maximum": 1535}
              },
              "additionalProperties": false
            },
            "preserve_high_frequency_residual": {"const": true},
            "purpose": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "topology_zones": {
          "type": "object",
          "required": [
            "preflight_region_ids",
            "base_level",
            "zones",
            "smoothing_radius_px",
            "source_low_pass_radius_px",
            "permission_envelope",
            "preserve_high_frequency_residual",
            "purpose"
          ],
          "properties": {
            "preflight_region_ids": {
              "type": "array",
              "prefixItems": [
                {"const": "north_east_range"},
                {"const": "south_east_range"}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "base_level": {"type": "integer", "minimum": 0, "maximum": 255},
            "zones": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "region_id", "role", "level", "points"],
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
                  "region_id": {"enum": ["north_east_range", "south_east_range"]},
                  "role": {
                    "enum": ["dominant-massif", "shaded-slope", "saddle", "foothill"]
                  },
                  "level": {"type": "integer", "minimum": 0, "maximum": 255},
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {"type": "integer", "minimum": 0, "maximum": 1535},
                        {"type": "integer", "minimum": 0, "maximum": 1023}
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minItems": 3,
                    "maxItems": 20
                  }
                },
                "additionalProperties": false
              },
              "minItems": 10,
              "maxItems": 12
            },
            "smoothing_radius_px": {"type": "integer", "minimum": 1, "maximum": 256},
            "source_low_pass_radius_px": {"type": "integer", "minimum": 1, "maximum": 256},
            "permission_envelope": {
              "type": "object",
              "required": ["shape", "zero_through_x", "opaque_from_x"],
              "properties": {
                "shape": {"const": "right-side-cosine-ramp"},
                "zero_through_x": {"type": "integer", "minimum": 0, "maximum": 1534},
                "opaque_from_x": {"type": "integer", "minimum": 1, "maximum": 1535}
              },
              "additionalProperties": false
            },
            "preserve_high_frequency_residual": {"const": true},
            "purpose": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "topology_ridges": {
          "type": "object",
          "required": [
            "preflight_region_ids",
            "regions",
            "target_input_q90_q10_levels",
            "elevation_smoothing_radius_px",
            "hillshade_gradient_step_px",
            "hillshade_gradient_scale",
            "light_vector_xyz",
            "hillshade_weight",
            "elevation_weight",
            "intermediate_field_scale",
            "hillshade_smoothing_radius_px",
            "source_low_pass_radius_px",
            "permission_envelope",
            "preserve_high_frequency_residual",
            "purpose"
          ],
          "properties": {
            "preflight_region_ids": {
              "type": "array",
              "prefixItems": [
                {"const": "north_east_range"},
                {"const": "south_east_range"}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["region_id", "ridge_nodes", "foothills"],
                "properties": {
                  "region_id": {"enum": ["north_east_range", "south_east_range"]},
                  "ridge_nodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "role", "point", "half_width_px", "height_levels"],
                      "properties": {
                        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
                        "role": {"enum": ["crest", "saddle", "shoulder"]},
                        "point": {
                          "type": "array",
                          "prefixItems": [
                            {"type": "integer", "minimum": -256, "maximum": 1791},
                            {"type": "integer", "minimum": -256, "maximum": 1279}
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "half_width_px": {"type": "integer", "minimum": 72, "maximum": 256},
                        "height_levels": {"type": "integer", "minimum": 1, "maximum": 96}
                      },
                      "additionalProperties": false
                    },
                    "minItems": 5,
                    "maxItems": 8
                  },
                  "foothills": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "center", "axes_px", "angle_degrees", "height_levels", "phase_radians"],
                      "properties": {
                        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
                        "center": {
                          "type": "array",
                          "prefixItems": [
                            {"type": "integer", "minimum": 0, "maximum": 1535},
                            {"type": "integer", "minimum": 0, "maximum": 1023}
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "axes_px": {
                          "type": "array",
                          "prefixItems": [
                            {"type": "integer", "minimum": 32, "maximum": 192},
                            {"type": "integer", "minimum": 32, "maximum": 192}
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "angle_degrees": {"type": "number", "minimum": -180, "maximum": 180},
                        "height_levels": {"type": "integer", "minimum": 1, "maximum": 96},
                        "phase_radians": {"type": "number", "minimum": 0, "maximum": 6.283186}
                      },
                      "additionalProperties": false
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 2
            },
            "target_input_q90_q10_levels": {"type": "number", "minimum": 31, "maximum": 40},
            "elevation_smoothing_radius_px": {"type": "integer", "minimum": 1, "maximum": 64},
            "hillshade_gradient_step_px": {"type": "integer", "minimum": 1, "maximum": 32},
            "hillshade_gradient_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 512},
            "light_vector_xyz": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": -1, "maximum": 1},
                {"type": "number", "minimum": -1, "maximum": 1},
                {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "hillshade_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
            "elevation_weight": {"type": "number", "minimum": 0, "maximum": 2},
            "intermediate_field_scale": {"type": "number", "minimum": 16, "maximum": 120},
            "hillshade_smoothing_radius_px": {"type": "integer", "minimum": 1, "maximum": 32},
            "source_low_pass_radius_px": {"type": "integer", "minimum": 1, "maximum": 256},
            "permission_envelope": {
              "type": "object",
              "required": ["shape", "zero_through_x", "opaque_from_x"],
              "properties": {
                "shape": {"const": "right-side-cosine-ramp"},
                "zero_through_x": {"type": "integer", "minimum": 0, "maximum": 1534},
                "opaque_from_x": {"type": "integer", "minimum": 1, "maximum": 1535}
              },
              "additionalProperties": false
            },
            "preserve_high_frequency_residual": {"const": true},
            "purpose": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "topology_compact_ridges": {
          "type": "object",
          "required": [
            "preflight_region_ids",
            "regions",
            "target_input_q90_q10_levels",
            "maximum_target_span_gain",
            "spline",
            "spline_subdivisions",
            "endpoint_taper_px",
            "cross_section_kernel",
            "primitive_composition",
            "elevation_smoothing_radius_px",
            "hillshade_gradient_step_px",
            "hillshade_vertical_scale",
            "light_vector_xyz",
            "hillshade_tanh_gain",
            "hillshade_balance",
            "hillshade_asymmetry",
            "hillshade_asymmetry_scale",
            "intermediate_field_scale",
            "hillshade_smoothing_radius_px",
            "field_tail_transform",
            "field_tail_activation_scale",
            "field_extrema_scale",
            "source_low_pass_radius_px",
            "permission_envelope",
            "preserve_high_frequency_residual",
            "purpose"
          ],
          "properties": {
            "preflight_region_ids": {
              "type": "array",
              "prefixItems": [
                {"const": "north_east_range"},
                {"const": "south_east_range"}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["region_id", "allowed_bbox", "primitives"],
                "properties": {
                  "region_id": {"enum": ["north_east_range", "south_east_range"]},
                  "allowed_bbox": {
                    "type": "array",
                    "prefixItems": [
                      {"type": "integer", "minimum": 0, "maximum": 1535},
                      {"type": "integer", "minimum": 0, "maximum": 1023},
                      {"type": "integer", "minimum": 0, "maximum": 1535},
                      {"type": "integer", "minimum": 0, "maximum": 1023}
                    ],
                    "items": false,
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "primitives": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "role", "nodes"],
                      "properties": {
                        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
                        "role": {"enum": ["main-ridge", "foothill"]},
                        "nodes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["id", "role", "point", "height", "lit_half_width_px", "shadow_half_width_px"],
                            "properties": {
                              "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
                              "role": {"enum": ["endpoint", "crest", "saddle", "shoulder"]},
                              "point": {
                                "type": "array",
                                "prefixItems": [
                                  {"type": "integer", "minimum": 0, "maximum": 1535},
                                  {"type": "integer", "minimum": 0, "maximum": 1023}
                                ],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
                              },
                              "height": {"type": "number", "minimum": 0, "maximum": 1},
                              "lit_half_width_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 192},
                              "shadow_half_width_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 192}
                            },
                            "additionalProperties": false
                          },
                          "minItems": 5,
                          "maxItems": 10
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 2
            },
            "target_input_q90_q10_levels": {"type": "number", "minimum": 31, "maximum": 40},
            "maximum_target_span_gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 512},
            "spline": {"const": "uniform-catmull-rom-with-c2-attribute-taper"},
            "spline_subdivisions": {"type": "integer", "minimum": 6, "maximum": 24},
            "endpoint_taper_px": {"type": "number", "minimum": 24, "maximum": 192},
            "cross_section_kernel": {"const": "q2-gte-1-zero-else-(1-q2)-cubed"},
            "primitive_composition": {"const": "canonical-id-product-union-then-single-hillshade"},
            "elevation_smoothing_radius_px": {"type": "number", "minimum": 0.5, "maximum": 16},
            "hillshade_gradient_step_px": {"type": "integer", "minimum": 1, "maximum": 16},
            "hillshade_vertical_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 128},
            "light_vector_xyz": {
              "type": "array",
              "prefixItems": [
                {"const": -0.557},
                {"const": -0.557},
