              {"required": ["minimum_areal_support"]},
              {"required": ["topology_mesh"]},
              {"required": ["topology_zones"]},
              {"required": ["topology_compact_ridges"]}
            ]
          }
        },
        {
          "required": ["topology_compact_ridges"],
          "not": {
            "anyOf": [
              {"required": ["low_pass"]},
              {"required": ["regional_gain"]},
              {"required": ["minimum_areal_support"]},
              {"required": ["topology_mesh"]},
              {"required": ["topology_zones"]},
              {"required": ["topology_ridges"]}
            ]
          }
        }
