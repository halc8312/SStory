{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sstory.example/schemas/phase5-source-index.schema.json",
  "title": "SStory Phase 5 high-resolution source index",
  "description": "Hash-locked Golden style, exact masters, reviewed deterministic composite masters, reviewed canonical-render masters, or guarded ImageGen metatiles supplied to build_phase5_assets.py. The Golden artifact must resolve to exactly one accepted 94+ manifest job, and every metatile receipt must use it. Reviewed sources require locked provenance, automated QA, and the required independent Vision reports; otherwise a normal master remains generated.",
  "type": "object",
  "required": [
    "schema_version",
    "coordinate_reference_system",
    "golden_style",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.3.0"
    },
    "coordinate_reference_system": {
      "const": "EA-WORLD-1"
    },
    "golden_style": {
      "$ref": "#/definitions/artifact"
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/master_source"
          },
          {
            "$ref": "#/definitions/composite_master_source"
          },
          {
            "$ref": "#/definitions/canonical_render_master_source"
          },
          {
            "$ref": "#/definitions/metatile_source"
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:/)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/path"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      },
      "additionalProperties": false
    },
    "master_source": {
      "type": "object",
      "required": [
        "sheet_id",
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "sheet_id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "const": "master"
        },
        "path": {
          "$ref": "#/definitions/path"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "provenance_report": {
          "$ref": "#/definitions/artifact"
        },
        "automated_report": {
          "$ref": "#/definitions/artifact"
        },
        "vision_reports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/artifact"
          }
        }
      },
      "dependencies": {
        "automated_report": [
          "vision_reports",
          "provenance_report"
        ],
        "vision_reports": [
          "automated_report",
          "provenance_report"
        ]
      },
      "additionalProperties": false
    },
    "composite_master_source": {
      "type": "object",
      "required": [
        "sheet_id",
        "kind",
        "path",
        "sha256",
        "provenance_report",
        "automated_report",
        "vision_reports"
      ],
      "properties": {
        "sheet_id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "const": "composite_master"
        },
        "path": {
          "$ref": "#/definitions/path"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "provenance_report": {
          "$ref": "#/definitions/artifact"
        },
        "automated_report": {
          "$ref": "#/definitions/artifact"
        },
        "vision_reports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/artifact"
          }
        }
      },
      "additionalProperties": false
    },
    "canonical_render_master_source": {
      "type": "object",
      "required": [
        "sheet_id",
        "kind",
        "path",
        "sha256",
        "provenance_report",
        "automated_report",
        "vision_reports"
      ],
      "properties": {
        "sheet_id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "const": "canonical_render_master"
        },
        "path": {
          "$ref": "#/definitions/path"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "provenance_report": {
          "$ref": "#/definitions/artifact"
        },
        "automated_report": {
          "$ref": "#/definitions/artifact"
        },
        "vision_reports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/artifact"
          }
        }
      },
      "additionalProperties": false
    },
    "metatile": {
      "type": "object",
      "required": [
        "column",
        "row",
        "path",
        "sha256",
        "receipt"
      ],
      "properties": {
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "$ref": "#/definitions/path"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "receipt": {
          "$ref": "#/definitions/artifact"
        }
      },
      "additionalProperties": false
    },
    "metatile_source": {
      "type": "object",
      "required": [
        "sheet_id",
        "kind",
        "tiles"
      ],
      "properties": {
        "sheet_id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "const": "metatiles"
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/metatile"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
